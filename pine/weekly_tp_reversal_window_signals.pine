//@version=5
indicator("Weekly TP Reversal Window Signals", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=250, max_bars_back=501)

// Indicator twin of the "Weekly TP Reversal Window Strategy". It reproduces the SAME decision logic and,
// instead of placing orders, prints an ENTRY marker and an EXIT marker with a short reason for each, so you
// can see WHERE to act and WHY. A position is simulated internally so stops / exits can be detected.
//   - Reversal window only (default Wed 13:15 -> Fri 09:45 UK).
//   - Bearish into the window (resistance, "down") -> fade LONG ; bullish ("up") -> fade SHORT.
//   - Entry: price trades within tpProxPct % of a TP level (and optionally the 0.83% reversal), in the
//     trend direction, once per window, on the correct side of the weekly open.
//   - Exit: 275-pt stop (always), TP-flip from Friday's window-end time, force-exit at the Friday time,
//     week-rollover safety.
// The LEVELS are chart-timeframe-independent (computed via request.security on calcTf). Turn on the
// execution-timeframe lock to pin the entry/exit/window decisions to a fixed timeframe too.

tpStep         = input.float(500, "TP Increment (points)", minval=1)
tpLevels       = input.int(10, "Number of TP Levels", minval=1, maxval=20)
trendThreshold = input.float(250, "Trend / Reversal Threshold (points)", minval=1)
tpUnit         = input.string("Percent", "TP / Threshold units", ["Points", "Percent"], tooltip="Points = fixed increments. Percent = increments scale with price (a % of the week's open), so levels stay proportional across a long backtest - e.g. a 500-pt step at ~30k ~ 1.66%.")
tpStepPct      = input.float(1.66, "TP Increment (% of price)", minval=0.01)
trendThreshPct = input.float(0.83, "Trend / Reversal Threshold (% of price)", minval=0.01)
showWeekLines  = input.bool(true, "Show Weekly High/Low/Open Lines")
calcTf         = input.timeframe("5", "Calculation Timeframe")

showVP    = input.bool(true, "Show Anchored Volume Profile", group="Volume Profile")
vpRows    = input.int(75, "Row Size", minval=5, maxval=100, group="Volume Profile")
vpWidth   = input.int(60, "Max Width (bars)", minval=10, maxval=200, group="Volume Profile")
vpBin     = input.float(2, "Accumulation Bin Size (points)", minval=0.25, group="Volume Profile")
vaPercent = input.float(70., "Value Area Volume %", minval=0, maxval=100, group="Volume Profile")
pocColorI = input.color(color.white, "POC Color", group="Volume Profile")
pocWidth  = input.int(2, "POC Width", minval=1, maxval=5, group="Volume Profile")
vaUpCol   = input.color(#26c6da, "Value Area Up", group="Volume Profile")
vaDnCol   = input.color(#ec407a, "Value Area Down", group="Volume Profile")
upCol     = input.color(color.new(#26c6da, 75), "Up Volume", group="Volume Profile")
dnCol     = input.color(color.new(#ec407a, 75), "Down Volume", group="Volume Profile")
showPoc   = input.bool(false, "Show POC Label", group="Volume Profile")
vpOffset  = input.int(0, "Right-side gap (bars past profile)", minval=0, maxval=300, group="Volume Profile", tooltip="The profile is auto-placed just to the right of price - its own Max Width is accounted for automatically, so it never overlaps the candles. This adds N extra bars of clearance beyond that. Total right-shift is capped at 500 (Pine's future-draw limit).")

showWarning  = input.bool(true, "Show Reversal Warning", group="Reversal Warning")
cutoffTz     = input.string("Europe/London", "Warning Timezone", group="Reversal Warning")
cutoffHour   = input.int(13, "Warning Start Hour (Wed)", minval=0, maxval=23, group="Reversal Warning")
cutoffMinute = input.int(15, "Warning Start Minute (Wed)", minval=0, maxval=59, group="Reversal Warning")
warnEndHour  = input.int(9, "Warning End Hour (Fri)", minval=0, maxval=23, group="Reversal Warning")
warnEndMin   = input.int(45, "Warning End Minute (Fri)", minval=0, maxval=59, group="Reversal Warning")

// ---- Signal / trade controls (mirror the strategy) ----
showSignals    = input.bool(true,  "Show entry/exit signals", group="Signals")
enableLongs    = input.bool(true,  "Signal Longs (green background)",  group="Signals")
enableShorts   = input.bool(true,  "Signal Shorts (red background)",   group="Signals")
useTPEntry     = input.bool(true,  "Enter only at a reversal/TP sweep", group="Signals", tooltip="Inside the reversal window, wait until price trades within the proximity % of a level (in the trend direction) before fading it. Off = enter at the window start.")
entryAtReversal = input.bool(false, "Also enter at the 0.83% reversal (shallow ~250-pt)", group="Signals", tooltip="On = the shallow ~250-pt (0.83%) reversal can trigger the entry, so signals fire earlier/closer to the extreme. Off = wait for a full TP level (~500 pts / 1.66% and deeper).")
tpProxPct      = input.float(0.088,  "Entry proximity %", minval=0.01, group="Signals", tooltip="How close (as a % of price) the bar must come to the reversal / TP level to trigger the entry signal.")
openTolPct     = input.float(0.0,  "Weekly-open tolerance %", minval=0, group="Signals", tooltip="How far past the weekly open an entry is still allowed. A LONG may enter below the open or up to this % above it; a SHORT above the open or up to this % below it. 0 = strict.")
useStop        = input.bool(true,  "Use Stop Loss",                   group="Signals")
stopUnit       = input.string("Percent", "Stop loss units", ["Points", "Percent"], group="Signals", tooltip="Points = a fixed point distance. Percent = a % of the entry price, so the stop scales with price (275 pts at ~30k ~ 0.9%).")
stopPts        = input.float(275,  "Stop Loss (points)", minval=1,    group="Signals")
stopPct        = input.float(0.89,  "Stop Loss (% of entry)", minval=0.01, group="Signals")
exitHour       = input.int(21,     "Force-exit hour (Fri)",   minval=0, maxval=23, group="Signals", tooltip="Latest exit on Friday, in the Warning Timezone.")
exitMin        = input.int(45,      "Force-exit minute (Fri)", minval=0, maxval=59, group="Signals")
lockExecTf     = input.bool(true, "Lock execution to a fixed timeframe", group="Signals", tooltip="On = read the entry / exit / window on a FIXED timeframe (below) via request.security, so changing the CHART timeframe no longer changes the signals. Keep the chart at that timeframe or LOWER.")
execLockTf     = input.timeframe("15", "Locked execution timeframe", group="Signals", tooltip="The timeframe the signals are pinned to when the lock above is on.")

// ---- Performance table controls ----
showPerfTable     = input.bool(true, "Show Performance Table", group="Performance Table")
startupCapital    = input.float(10000, "Startup Capital ($)", minval=1, group="Performance Table", tooltip="Baseline account size used to turn each simulated trade's % return into a $ P&L. Each trade is assumed to compound the full account equity, same convention as a simple % based backtest.")
perfLookbackDays  = input.int(90, "Performance Window (days)", minval=0, group="Performance Table", tooltip="Only trades that CLOSED within this many days of the most recent bar are included in the table. 0 = use all available history.")
showTotalPnl      = input.bool(true, "Show Total PnL", group="Performance Table")
showProfitFactor  = input.bool(true, "Show Profit Factor", group="Performance Table")
showWinRate       = input.bool(true, "Show Profitable Trades (Win Rate)", group="Performance Table")
showMaxDD         = input.bool(true, "Show Max Drawdown", group="Performance Table")
perfTablePosStr   = input.string("Top Right", "Table Position", options=["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group="Performance Table")
perfTableSizeStr  = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal", "Large"], group="Performance Table")

perfTablePosition = switch perfTablePosStr
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    => position.top_right

perfTextSize = switch perfTableSizeStr
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    => size.small

formatPrice(x) =>
    r = math.round(x)
    s = str.tostring(r)
    neg = str.startswith(s, "-")
    digits = neg ? str.substring(s, 1) : s
    l = str.length(digits)
    out = ""
    for idx = 0 to l - 1
        out += str.substring(digits, idx, idx + 1)
        remaining = l - idx - 1
        if remaining > 0 and remaining % 3 == 0
            out += ","
    neg ? "-" + out : out

// volume contained where a price segment [y21,y22] intersects a row [y11,y12]
get_vol(y11, y12, y21, y22, height, vol) =>
    nz(math.max(math.min(math.max(y11, y12), math.max(y21, y22)) - math.max(math.min(y11, y12), math.min(y21, y22)), 0) * vol / height)

calc() =>
    var float wHigh    = na
    var float wLow     = na
    var float weekOpen = na
    var string mode       = na
    var int confirmedUp   = 0
    var int confirmedDown = 0
    var float lastResistance = na
    var float lastSupport    = na
    var float legHigh = na
    var float legLow  = na
    var int wHighTime = na
    var int wLowTime  = na
    var int weekStartTime = na

    newWeek = ta.change(time("W")) != 0

    if newWeek or na(wHigh)
        wHigh := high
        wLow  := low
        weekOpen := open
        wHighTime := time
        wLowTime := time
        weekStartTime := time
        mode := na
        confirmedUp := 0
        confirmedDown := 0
        lastResistance := na
        lastSupport := na
        legHigh := na
        legLow := na
    else
        if high > wHigh
            wHigh := high
            wHighTime := time
        if low < wLow
            wLow := low
            wLowTime := time

    // Effective TP increment / trend threshold. In Percent mode these are EXACT %s of the relevant weekly
    // extreme, so down-TPs sit at 1.66%/3.32%/4.98%... below the HIGH and up-TPs the same above the LOW,
    // and the 0.83% direction threshold is measured off the same extreme. Fixed points otherwise.
    float tpStepUp = tpUnit == "Percent" and not na(wLow)  ? wLow  * tpStepPct / 100      : tpStep
    float tpStepDn = tpUnit == "Percent" and not na(wHigh) ? wHigh * tpStepPct / 100      : tpStep
    float threshUp = tpUnit == "Percent" and not na(wLow)  ? wLow  * trendThreshPct / 100 : trendThreshold
    float threshDn = tpUnit == "Percent" and not na(wHigh) ? wHigh * trendThreshPct / 100 : trendThreshold

    // TP hit tracking: legHigh/legLow mirror wHigh/wLow but reset fresh on each flip.
    float prevLegHigh = legHigh
    float prevLegLow  = legLow
    legHigh := na(legHigh) ? high : math.max(legHigh, high)
    legLow  := na(legLow) ? low : math.min(legLow, low)
    madeNewLegHigh = na(prevLegHigh) or legHigh != prevLegHigh
    madeNewLegLow  = na(prevLegLow) or legLow != prevLegLow

    newConfirmedUp   = confirmedUp
    newConfirmedDown = confirmedDown
    if madeNewLegHigh
        for i = 1 to tpLevels
            if legHigh >= wLow + tpStepUp * i
                newConfirmedUp := i
    if madeNewLegLow
        for i = 1 to tpLevels
            if legLow <= wHigh - tpStepDn * i
                newConfirmedDown := i
    confirmedUp := newConfirmedUp
    confirmedDown := newConfirmedDown

    // Trend / reversal, both sides, always.
    bearSignal = not na(wHigh) and not na(wLow) and close <= wHigh - threshDn
    bullSignal = not na(wHigh) and not na(wLow) and close >= wLow + threshUp

    prevMode = mode
    if bullSignal and not bearSignal
        mode := "up"
    else if bearSignal and not bullSignal
        mode := "down"

    if mode != prevMode
        if prevMode == "up" and confirmedUp > 0
            lastResistance := wLow + tpStepUp * confirmedUp
        if prevMode == "down" and confirmedDown > 0
            lastSupport := wHigh - tpStepDn * confirmedDown
        if mode == "up" and prevMode == "down"
            legHigh := na
        if mode == "down" and prevMode == "up"
            legLow := na

    // ---- Volume profile (accumulated into fixed absolute price bins, reset weekly).
    var map<int, float> vpUp = map.new<int, float>()
    var map<int, float> vpDn = map.new<int, float>()
    if newWeek
        map.clear(vpUp)
        map.clear(vpDn)
    if showVP and not na(volume) and volume > 0
        bTop = math.max(close, open)
        bBot = math.min(close, open)
        green = close >= open
        tw = high - bTop
        bw = bBot - low
        bd = bTop - bBot
        den = 2 * tw + 2 * bw + bd
        if den > 0
            bv  = bd * volume / den
            twv = 2 * tw * volume / den
            bwv = 2 * bw * volume / den
            loBin = int(math.floor(low / vpBin))
            hiBin = int(math.floor(high / vpBin))
            for bi = loBin to hiBin
                binLo = bi * vpBin
                binHi = binLo + vpBin
                wa = get_vol(binLo, binHi, bTop, high, tw, twv) / 2 + get_vol(binLo, binHi, bBot, low, bw, bwv) / 2
                ua = (green ? get_vol(binLo, binHi, bBot, bTop, bd, bv) : 0) + wa
                da = (green ? 0 : get_vol(binLo, binHi, bBot, bTop, bd, bv)) + wa
                cu = map.contains(vpUp, bi) ? map.get(vpUp, bi) : 0.0
                map.put(vpUp, bi, cu + ua)
                cd = map.contains(vpDn, bi) ? map.get(vpDn, bi) : 0.0
                map.put(vpDn, bi, cd + da)

    var float[] vpLevels  = array.new_float(0)
    var float[] vpVolumes = array.new_float(0)
    float vpTop = na
    float vpBot = na
    if showVP and barstate.islast and not na(wHigh) and not na(wLow) and wHigh > wLow
        vpTop := wHigh
        vpBot := wLow
        cn = vpRows
        binSize = (wHigh - wLow) / cn
        array.clear(vpLevels)
        for x = 0 to cn
            array.push(vpLevels, wLow + binSize * x)
        array.clear(vpVolumes)
        for x = 0 to cn * 2 - 1
            array.push(vpVolumes, 0.0)
        for [bi, uv] in vpUp
            price = (bi + 0.5) * vpBin
            if price >= wLow and price < wHigh
                row = int((price - wLow) / binSize)
                row := math.min(math.max(row, 0), cn - 1)
                array.set(vpVolumes, row, array.get(vpVolumes, row) + uv)
        for [bi, dv] in vpDn
            price = (bi + 0.5) * vpBin
            if price >= wLow and price < wHigh
                row = int((price - wLow) / binSize)
                row := math.min(math.max(row, 0), cn - 1)
                array.set(vpVolumes, row + cn, array.get(vpVolumes, row + cn) + dv)

    [wHigh, wLow, weekOpen, mode, confirmedUp, confirmedDown, lastResistance, lastSupport, legHigh, legLow, wHighTime, wLowTime, weekStartTime, vpLevels, vpVolumes, vpTop, vpBot]

[wHigh, wLow, weekOpen, mode, confirmedUp, confirmedDown, lastResistance, lastSupport, legHigh, legLow, wHighTime, wLowTime, weekStartTime, vpLevels, vpVolumes, vpTop, vpBot] = request.security(syminfo.tickerid, calcTf, calc())

modeChanged = mode != mode[1]
confirmedCount = mode == "up" ? confirmedUp : mode == "down" ? confirmedDown : 0

// ---- Optional execution-timeframe lock (same as the strategy). When ON, entry / exit / window read a
// FIXED timeframe via request.security (non-repainting), so changing the CHART timeframe no longer changes
// the signals. When OFF, x* fall through to the chart's own series. ----
[sHigh, sLow, sClose, sTime] = request.security(syminfo.tickerid, execLockTf, [high, low, close, time], lookahead=barmerge.lookahead_off)
float xHigh   = lockExecTf ? sHigh  : high
float xLow    = lockExecTf ? sLow   : low
float xClose  = lockExecTf ? sClose : close
int   xTime   = lockExecTf ? sTime  : time
bool  xNewBar = lockExecTf ? (ta.change(sTime) != 0) : true

// Effective TP increment / reversal threshold in the chart scope (same anchor-based rule as inside calc).
float tpStepUpMain = tpUnit == "Percent" and not na(wLow)  ? wLow  * tpStepPct / 100 : tpStep
float tpStepDnMain = tpUnit == "Percent" and not na(wHigh) ? wHigh * tpStepPct / 100 : tpStep
float threshUpMain = tpUnit == "Percent" and not na(wLow)  ? wLow  * trendThreshPct / 100 : trendThreshold
float threshDnMain = tpUnit == "Percent" and not na(wHigh) ? wHigh * trendThreshPct / 100 : trendThreshold

// ---- Draw the volume profile. Right-anchored at (current bar + width + gap), extending left. ----
var box[] vpBoxes = array.new_box()
var line pocLine = na
var label pocLabel = na

vpSize = na(vpVolumes) ? 0 : array.size(vpVolumes)
if showVP and barstate.islast and vpSize == vpRows * 2 and not na(vpTop) and not na(vpBot) and vpTop > vpBot
    cnum = vpRows
    dist = (vpTop - vpBot) / 500
    totalvols = array.new_float(cnum, 0.)
    for x = 0 to cnum - 1
        array.set(totalvols, x, array.get(vpVolumes, x) + array.get(vpVolumes, x + cnum))

    int poc = array.indexof(totalvols, array.max(totalvols))

    totalmax = array.sum(totalvols) * vaPercent / 100.
    va_total = array.get(totalvols, poc)
    int up = poc
    int down = poc
    for x = 0 to cnum - 1
        if va_total >= totalmax
            break
        uppervol = up < cnum - 1 ? array.get(totalvols, up + 1) : 0.
        lowervol = down > 0 ? array.get(totalvols, down - 1) : 0.
        if uppervol == 0 and lowervol == 0
            break
        if uppervol >= lowervol
            va_total += uppervol
            up += 1
        else
            va_total += lowervol
            down -= 1

    maxvol = array.max(totalvols)
    scaled = array.new_float(cnum * 2, 0.)
    if maxvol > 0
        for x = 0 to cnum * 2 - 1
            array.set(scaled, x, array.get(vpVolumes, x) * vpWidth / maxvol)

    while array.size(vpBoxes) > 0
        box.delete(array.pop(vpBoxes))
    rightX = bar_index + math.min(500, vpWidth + vpOffset)
    for x = 0 to cnum - 1
        upW = math.round(array.get(scaled, x))
        dnW = math.round(array.get(scaled, x + cnum))
        lv0 = array.get(vpLevels, x)
        lv1 = array.get(vpLevels, x + 1)
        inVA = x >= down and x <= up
        b1 = box.new(rightX - upW, lv1 - dist, rightX, lv0 + dist, border_width=0, bgcolor=inVA ? vaUpCol : upCol)
        b2 = box.new(rightX - upW - dnW, lv1 - dist, rightX - upW, lv0 + dist, border_width=0, bgcolor=inVA ? vaDnCol : dnCol)
        array.push(vpBoxes, b1)
        array.push(vpBoxes, b2)

    poc_level = (array.get(vpLevels, poc) + array.get(vpLevels, poc + 1)) / 2
    line.delete(pocLine)
    pocLine := line.new(rightX - 1, poc_level, rightX, poc_level, extend=extend.left, color=pocColorI, width=pocWidth)
    label.delete(pocLabel)
    if showPoc
        pocLabel := label.new(rightX + 15, poc_level, text="POC: " + str.tostring(math.round_to_mintick(poc_level)), style=close >= poc_level ? label.style_label_up : label.style_label_down)

// ---- Weekly high / low / open lines, one persistent set PER WEEK ----
var line whLine = na
var line wlLine = na
var line woLine = na
newWeekChart = ta.change(time("W")) != 0
if showWeekLines and not na(wHigh)
    if na(whLine) or newWeekChart
        whLine := line.new(bar_index, wHigh, bar_index, wHigh, color=color.green, width=2)
        wlLine := line.new(bar_index, wLow, bar_index, wLow, color=color.red, width=2)
        woLine := line.new(bar_index, weekOpen, bar_index, weekOpen, color=color.yellow, width=2)
    else
        line.set_y1(whLine, wHigh)
        line.set_xy2(whLine, bar_index, wHigh)
        line.set_y1(wlLine, wLow)
        line.set_xy2(wlLine, bar_index, wLow)
        line.set_y1(woLine, weekOpen)
        line.set_xy2(woLine, bar_index, weekOpen)

var line[] tpLines = array.new_line()
var label[] tpLabels = array.new_label()

if barstate.islast
    while array.size(tpLines) > 0
        line.delete(array.pop(tpLines))
    while array.size(tpLabels) > 0
        label.delete(array.pop(tpLabels))

    resActive = not na(lastResistance) and close < lastResistance
    supActive = not na(lastSupport) and close > lastSupport

    if not na(mode)
        lineColor = mode == "up" ? color.lime : color.orange
        stepUsed = mode == "up" ? tpStepUpMain : tpStepDnMain
        for i = 1 to tpLevels
            lvl = mode == "up" ? wLow + stepUsed * i : wHigh - stepUsed * i
            onResistance = resActive and math.round(lvl) == math.round(lastResistance)
            onSupport    = supActive and math.round(lvl) == math.round(lastSupport)
            if not onResistance and not onSupport
                hit = i <= confirmedCount
                ln = line.new(bar_index, lvl, bar_index + 30, lvl, color=lineColor, style=line.style_dashed, width=hit ? 2 : 1)
                labelText = "TP" + str.tostring(i) + (hit ? " * " : "  ") + formatPrice(lvl) + " (" + str.tostring(int(stepUsed * i)) + " points)"
                lb = label.new(bar_index + 30, lvl, labelText, style=label.style_label_left, color=color.new(lineColor, hit ? 15 : 55), textcolor=color.white, size=size.small)
                array.push(tpLines, ln)
                array.push(tpLabels, lb)

    if not na(lastResistance) and close < lastResistance
        rln = line.new(bar_index, lastResistance, bar_index + 30, lastResistance, color=color.fuchsia, style=line.style_dotted, width=1)
        rlb = label.new(bar_index + 30, lastResistance, "Resistance " + formatPrice(lastResistance), style=label.style_label_left, color=color.new(color.fuchsia, 55), textcolor=color.white, size=size.small)
        array.push(tpLines, rln)
        array.push(tpLabels, rlb)

    if not na(lastSupport) and close > lastSupport
        sln = line.new(bar_index, lastSupport, bar_index + 30, lastSupport, color=color.aqua, style=line.style_dotted, width=1)
        slb = label.new(bar_index + 30, lastSupport, "Support " + formatPrice(lastSupport), style=label.style_label_left, color=color.new(color.aqua, 55), textcolor=color.white, size=size.small)
        array.push(tpLines, sln)
        array.push(tpLabels, slb)

// ---- Reversal warning window (Wed start time -> Fri end time, in cutoffTz), aligned to xTime ----
wDow  = dayofweek(xTime, cutoffTz)
wHour = hour(xTime, cutoffTz)
wMin  = minute(xTime, cutoffTz)
afterStart = wDow > dayofweek.wednesday or (wDow == dayofweek.wednesday and (wHour > cutoffHour or (wHour == cutoffHour and wMin >= cutoffMinute)))
beforeEnd  = wDow < dayofweek.friday or (wDow == dayofweek.friday and (wHour < warnEndHour or (wHour == warnEndHour and wMin < warnEndMin)))
inWarnWindow = afterStart and beforeEnd

// Colour locked to the trend entering the window: bearish -> green (reversal up), bullish -> red (reversal down).
var string warnTrend = na
if ta.change(time("W")) != 0
    warnTrend := na
if inWarnWindow and not inWarnWindow[1]
    warnTrend := mode
bgTint = warnTrend == "down" ? color.new(color.green, 88) : warnTrend == "up" ? color.new(color.red, 88) : na
bgcolor(showWarning and inWarnWindow ? bgTint : na, title="Reversal Window")

// ==================================================================================================
//                              ENTRY / EXIT SIGNALS (simulated position)
// ==================================================================================================
// Direction "down" (green, reversal UP) -> LONG ; "up" (red, reversal DOWN) -> SHORT.
windowStart = inWarnWindow and not inWarnWindow[1]

var bool tradedWindow = false
if windowStart
    tradedWindow := false
string dir = not na(warnTrend) ? warnTrend : mode   // captured trend, else live trend

// Which level (if any) is being touched this bar, and its name - shallowest first so the label shows the
// level that actually triggered.
bool nearTP = false
float trigLvl = na
string trigName = ""
if dir == "down"
    if entryAtReversal
        float rlvl = wHigh - threshDnMain
        if not na(rlvl) and rlvl > 0 and math.abs(xLow - rlvl) <= rlvl * tpProxPct / 100
            nearTP := true
            if na(trigLvl)
                trigLvl := rlvl
                trigName := "0.83% reversal"
    for i = 1 to tpLevels
        float lvl = wHigh - tpStepDnMain * i
        if not na(lvl) and lvl > 0 and math.abs(xLow - lvl) <= lvl * tpProxPct / 100
            nearTP := true
            if na(trigLvl)
                trigLvl := lvl
                trigName := "TP" + str.tostring(i)
else if dir == "up"
    if entryAtReversal
        float rlvl = wLow + threshUpMain
        if not na(rlvl) and rlvl > 0 and math.abs(xHigh - rlvl) <= rlvl * tpProxPct / 100
            nearTP := true
            if na(trigLvl)
                trigLvl := rlvl
                trigName := "0.83% reversal"
    for i = 1 to tpLevels
        float lvl = wLow + tpStepUpMain * i
        if not na(lvl) and lvl > 0 and math.abs(xHigh - lvl) <= lvl * tpProxPct / 100
            nearTP := true
            if na(trigLvl)
                trigLvl := lvl
                trigName := "TP" + str.tostring(i)
bool entryTrigger = useTPEntry ? nearTP : true

// Weekly-open filter: LONG below the open (or up to openTolPct% above); SHORT above (or up to openTolPct% below).
bool openOkLong  = not na(weekOpen) and xClose < weekOpen * (1 + openTolPct / 100)
bool openOkShort = not na(weekOpen) and xClose > weekOpen * (1 - openTolPct / 100)

// Exit-timing gates.
afterWindowEnd = wDow == dayofweek.friday and (wHour > warnEndHour or (wHour == warnEndHour and wMin >= warnEndMin))
forceExit      = wDow == dayofweek.friday and (wHour > exitHour or (wHour == exitHour and wMin >= exitMin))
weekRollover   = ta.change(time("W")) != 0

// Simulated position: 0 flat, 1 long, -1 short.
var int    posDir   = 0
var float  posEntry = na

// Closed-trade log, used to build the performance table below. tradeRetPct is the trade's % return
// (in the trend direction), tradeExitTime is the bar time the trade closed.
var float[] tradeRetPct   = array.new_float(0)
var int[]   tradeExitTime = array.new_int(0)

bool  longEntrySig  = false
bool  shortEntrySig = false
bool  exitSig       = false
float exitPx        = na
string exitWhy      = ""

// ---- Entry (only when flat) ----
enteredThisBar = false
if posDir == 0 and inWarnWindow and not tradedWindow and not na(dir) and entryTrigger and xNewBar
    if dir == "down" and enableLongs and openOkLong
        posDir := 1
        posEntry := xClose
        tradedWindow := true
        longEntrySig := true
        enteredThisBar := true
    else if dir == "up" and enableShorts and openOkShort
        posDir := -1
        posEntry := xClose
        tradedWindow := true
        shortEntrySig := true
        enteredThisBar := true

// ---- Exit (only when in a position, and not the bar we just entered on) ----
if posDir != 0 and not enteredThisBar
    float stopDist = stopUnit == "Percent" ? posEntry * stopPct / 100 : stopPts
    string stopTxt = "Stop -" + (stopUnit == "Percent" ? str.tostring(stopPct) + "%" : str.tostring(stopPts) + "pts")
    if useStop and posDir == 1 and xLow <= posEntry - stopDist
        exitPx := posEntry - stopDist
        exitWhy := stopTxt
        exitSig := true
    else if useStop and posDir == -1 and xHigh >= posEntry + stopDist
        exitPx := posEntry + stopDist
        exitWhy := stopTxt
        exitSig := true
    else if afterWindowEnd and xNewBar and posDir == 1 and mode == "down"
        exitPx := xClose
        exitWhy := "TP resistance flip"
        exitSig := true
    else if afterWindowEnd and xNewBar and posDir == -1 and mode == "up"
        exitPx := xClose
        exitWhy := "TP support flip"
        exitSig := true
    else if forceExit and xNewBar
        exitPx := xClose
        exitWhy := "Fri time stop"
        exitSig := true
    else if weekRollover
        exitPx := xClose
        exitWhy := "Week end (safety)"
        exitSig := true

// Remember the side we are closing before we reset, for the label / P&L.
int   exitDir     = posDir
float exitPnl     = exitSig ? (exitDir == 1 ? exitPx - posEntry : posEntry - exitPx) : na
float exitRetPct  = exitSig ? (exitDir == 1 ? (exitPx - posEntry) / posEntry : (posEntry - exitPx) / posEntry) : na
if exitSig
    array.push(tradeRetPct, exitRetPct)
    array.push(tradeExitTime, xTime)
    posDir := 0
    posEntry := na

// ---- Draw the markers with reasons ----
if showSignals and longEntrySig
    txt = "LONG @ " + formatPrice(posEntry) + "\nFade for reversal UP\nTouched " + trigName + " " + formatPrice(trigLvl) + "\nBelow wk open " + formatPrice(weekOpen)
    label.new(bar_index, low, txt, style=label.style_label_up, yloc=yloc.belowbar, color=color.new(color.green, 15), textcolor=color.white, size=size.small)
if showSignals and shortEntrySig
    txt = "SHORT @ " + formatPrice(posEntry) + "\nFade for reversal DOWN\nTouched " + trigName + " " + formatPrice(trigLvl) + "\nAbove wk open " + formatPrice(weekOpen)
    label.new(bar_index, high, txt, style=label.style_label_down, yloc=yloc.abovebar, color=color.new(color.red, 15), textcolor=color.white, size=size.small)
if showSignals and exitSig
    win = exitPnl >= 0
    txt = "EXIT " + (exitDir == 1 ? "LONG" : "SHORT") + " @ " + formatPrice(exitPx) + "\n" + exitWhy + "\n" + (win ? "+" : "") + formatPrice(exitPnl) + " pts"
    label.new(bar_index, exitPx, txt, style=exitDir == 1 ? label.style_label_down : label.style_label_up, color=color.new(win ? color.teal : color.maroon, 15), textcolor=color.white, size=size.small)

// Clean directional shapes as well (small, always at the bar).
plotshape(showSignals and longEntrySig,  title="Long entry",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(showSignals and shortEntrySig, title="Short entry", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)
plotshape(showSignals and exitSig,       title="Exit",        style=shape.xcross,        location=location.absolute, color=color.gray, size=size.tiny)

// ---- Alerts ----
alertcondition(longEntrySig,  title="Long entry",  message="Weekly TP Reversal: LONG entry signal")
alertcondition(shortEntrySig, title="Short entry", message="Weekly TP Reversal: SHORT entry signal")
alertcondition(exitSig,       title="Exit",        message="Weekly TP Reversal: EXIT signal")

// ==================================================================================================
//                                      PERFORMANCE TABLE
// ==================================================================================================
// Rebuilds a compounding equity curve from the simulated trades' % returns (each trade is assumed to
// compound the full account equity, the same convention as a simple % based backtest), filtered to
// trades that closed within the lookback window, then reports profit factor / win rate / max drawdown /
// total P&L. Every row - and the table itself - can be toggled off in the Performance Table settings.
var table perfTable = na

if showPerfTable and barstate.islast
    if not na(perfTable)
        table.delete(perfTable)

    int cutoffTime = perfLookbackDays > 0 ? xTime - perfLookbackDays * 86400000 : int(na)

    float equity      = startupCapital
    float peakEquity  = startupCapital
    float maxDDPct    = 0.0
    float grossProfit = 0.0
    float grossLoss   = 0.0
    int   wins        = 0
    int   totalTrades = 0

    nTrades = array.size(tradeRetPct)
    if nTrades > 0
        for i = 0 to nTrades - 1
            tExit = array.get(tradeExitTime, i)
            if perfLookbackDays == 0 or tExit >= cutoffTime
                ret = array.get(tradeRetPct, i)
                pnlDollar = equity * ret
                equity += pnlDollar
                totalTrades += 1
                if pnlDollar >= 0
                    grossProfit += pnlDollar
                    wins += 1
                else
                    grossLoss += -pnlDollar
                peakEquity := math.max(peakEquity, equity)
                ddPct = peakEquity > 0 ? (peakEquity - equity) / peakEquity * 100 : 0.0
                maxDDPct := math.max(maxDDPct, ddPct)

    totalPnlDollar = equity - startupCapital
    totalPnlPct    = startupCapital > 0 ? totalPnlDollar / startupCapital * 100 : 0.0

    nRows = 1 + (showTotalPnl ? 1 : 0) + (showProfitFactor ? 1 : 0) + (showWinRate ? 1 : 0) + (showMaxDD ? 1 : 0)
    perfTable := table.new(perfTablePosition, 2, math.max(nRows, 1), bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

    table.cell(perfTable, 0, 0, "Performance", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=perfTextSize, text_halign=text.align_left)
    table.cell(perfTable, 1, 0, str.tostring(totalTrades) + " trades", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=perfTextSize, text_halign=text.align_right)

    row = 1
    if showTotalPnl
        pnlColor = totalPnlDollar >= 0 ? color.lime : color.red
        pnlText  = (totalPnlDollar >= 0 ? "+$" : "-$") + formatPrice(math.abs(totalPnlDollar)) + " (" + (totalPnlPct >= 0 ? "+" : "") + str.tostring(totalPnlPct, "#.##") + "%)"
        table.cell(perfTable, 0, row, "Total PnL", text_color=color.silver, text_size=perfTextSize, text_halign=text.align_left)
        table.cell(perfTable, 1, row, pnlText, text_color=pnlColor, text_size=perfTextSize, text_halign=text.align_right)
        row += 1
    if showProfitFactor
        pfText = totalTrades == 0 ? "n/a" : grossLoss > 0 ? str.tostring(grossProfit / grossLoss, "#.##") : grossProfit > 0 ? "∞" : "n/a"
        table.cell(perfTable, 0, row, "Profit Factor", text_color=color.silver, text_size=perfTextSize, text_halign=text.align_left)
        table.cell(perfTable, 1, row, pfText, text_color=color.white, text_size=perfTextSize, text_halign=text.align_right)
        row += 1
    if showWinRate
        wrText = totalTrades == 0 ? "n/a" : str.tostring(wins / totalTrades * 100.0, "#.##") + "% (" + str.tostring(wins) + "/" + str.tostring(totalTrades) + ")"
        table.cell(perfTable, 0, row, "Profitable Trades", text_color=color.silver, text_size=perfTextSize, text_halign=text.align_left)
        table.cell(perfTable, 1, row, wrText, text_color=color.white, text_size=perfTextSize, text_halign=text.align_right)
        row += 1
    if showMaxDD
        ddText = totalTrades == 0 ? "n/a" : "-" + str.tostring(maxDDPct, "#.##") + "%"
        table.cell(perfTable, 0, row, "Max Drawdown", text_color=color.silver, text_size=perfTextSize, text_halign=text.align_left)
        table.cell(perfTable, 1, row, ddText, text_color=color.orange, text_size=perfTextSize, text_halign=text.align_right)
        row += 1
